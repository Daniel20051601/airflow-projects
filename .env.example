AIRFLOW_PROJ_DIR=           # Ruta base del proyecto Airflow (ejemplo: D:/airflow)
AIRFLOW_UID=                # UID del usuario para los contenedores (ejemplo: 50000)
CINE_RECOMMENDER_PATH=      # Ruta absoluta al proyecto CineRecommender (ejemplo: D:/Data Engineer/CineRecomender)
FERNET_KEY=                 # Clave Fernet para cifrado en Airflow (genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
_PIP_ADDITIONAL_REQUIREMENTS=pandas psycopg2-binary pycountry python-dotenv requests sqlalchemy tqdm   # Paquetes Python adicionales a instalar en los contenedores

TMDB_API_TOKEN=             # Token de acceso Bearer v4 de The Movie Database (TMDB)
DATABASE_URL=               # URL de conexión a la base de datos de películas (ejemplo: postgresql://usuario:contraseña@host:puerto/basededatos)
